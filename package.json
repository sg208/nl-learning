{
  "name": "nl-learning",
  "version": "0.1.1",
  "description": "Accessible PWA for non-Dutch speakers learning KNM and civic integration in the Netherlands.",
  "license": "MIT",
  "author": "Syailendra Ginting",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "serve dist -l ${PORT:-3000}",
    "check": "astro check && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{astro,ts,tsx,js,jsx,mjs,cjs,md,mdx,css,json}\"",
    "format:check": "prettier --check \"**/*.{astro,ts,tsx,js,jsx,mjs,cjs,md,mdx,css,json}\"",
    "fix": "pnpm run lint:fix && pnpm run format",
    "test": "vitest run",
    "preview:e2e": "astro preview --port 4173 --host 127.0.0.1 --ignore-lock",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "icons": "node scripts/generate-pwa-icons.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.4",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.34.8",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "compression": "^1.8.2"
    }
  }
}

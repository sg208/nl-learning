---
import { localizedPath } from '~/lib/i18n';
import type { Locale } from '~/lib/i18n';

interface Props {
  locale: Locale;
  eyebrow: string;
  title: string;
  lead: string;
  ctaPrimary: string;
  ctaSecondary: string;
}

const { locale, eyebrow, title, lead, ctaPrimary, ctaSecondary } = Astro.props;
---

<section class="home-hero relative flex flex-col items-center px-0 pb-20 text-center sm:pb-24">
  <div class="home-hero__glow pointer-events-none" aria-hidden="true"></div>

  <div class="home-hero__content relative flex w-full max-w-3xl flex-col items-center">
    <div class="rise flex items-center justify-center gap-3 sm:gap-4">
      <span class="h-px w-8 bg-[var(--rule)] sm:w-12" aria-hidden="true"></span>
      <p
        class="font-[family-name:var(--font-mono)] text-[0.6875rem] font-bold tracking-[0.28em] text-[var(--accent)] uppercase sm:text-xs"
      >
        {eyebrow}
      </p>
      <span class="h-px w-8 bg-[var(--rule)] sm:w-12" aria-hidden="true"></span>
    </div>

    <h1
      class="rise rise-1 mx-auto mt-6 max-w-[18ch] font-[family-name:var(--font-display)] text-[clamp(2.125rem,6vw,3.75rem)] leading-[1.06] font-bold tracking-tight text-balance"
    >
      {title}
    </h1>

    <p
      class="rise rise-2 mx-auto mt-6 max-w-[42ch] text-base leading-relaxed text-[var(--muted)] sm:mt-7 sm:text-lg sm:leading-relaxed"
    >
      {lead}
    </p>

    <div
      class="rise rise-3 mt-9 flex w-full max-w-sm flex-col items-stretch gap-3 sm:max-w-none sm:flex-row sm:justify-center"
    >
      <a href={localizedPath('/knm', locale)} class="btn btn-primary">{ctaPrimary}</a>
      <a href={localizedPath('/about', locale)} class="btn btn-secondary">{ctaSecondary}</a>
    </div>
  </div>
</section>

<style>
  .home-hero__glow {
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: min(28rem, 70vw);
    background:
      radial-gradient(ellipse 70% 55% at 50% 0%, rgb(230 57 70 / 0.14), transparent 68%),
      radial-gradient(ellipse 45% 40% at 50% 20%, rgb(42 157 143 / 0.08), transparent 72%);
  }

  .home-hero__content {
    padding-top: 2rem;
  }

  @media (min-width: 640px) {
    .home-hero__content {
      padding-top: 2.5rem;
    }
  }
</style>

---
import { localizedPath } from '~/lib/i18n';
import type { Locale } from '~/lib/i18n';
import HomeFacts, { type HomeFact } from './HomeFacts.astro';

interface Props {
  locale: Locale;
  audience: string;
  titleLines: [string, string];
  lead: string;
  ctaPrimary: string;
  ctaSecondary: string;
  factsLabel: string;
  facts: HomeFact[];
}

const { locale, audience, titleLines, lead, ctaPrimary, ctaSecondary, factsLabel, facts } =
  Astro.props;
---

<section class="home-hero" aria-labelledby="home-title">
  <HomeFacts label={factsLabel} facts={facts} />

  <div class="home-hero__body page-frame">
    <h1 id="home-title" class="home-hero__title">
      <span class="mask-line">
        <span>{titleLines[0]}</span>
      </span>{' '}
      <span class="mask-line">
        <span>{titleLines[1]}</span>
      </span>
    </h1>

    <p class="home-hero__lead rise rise-2">
      <strong>{audience}</strong> {lead}
    </p>

    <div class="home-hero__actions rise rise-3">
      <a href={localizedPath('/knm', locale)} class="btn btn-primary">
        {ctaPrimary}
      </a>
      <a href={localizedPath('/about', locale)} class="btn btn-secondary">
        {ctaSecondary}
      </a>
    </div>
  </div>
</section>

<style>
  .home-hero__body {
    display: grid;
    gap: 1.5rem;
    padding-top: clamp(2rem, 1rem + 4vw, 5rem);
  }

  .home-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.125rem, 1.1rem + 3.4vw, 3.75rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.025em;
    color: var(--ink);
  }

  .home-hero__lead {
    max-width: 38ch;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .home-hero__lead strong {
    font-weight: 600;
    color: var(--ink);
  }

  .home-hero__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .home-hero__actions {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  @media (min-width: 960px) {
    .home-hero__body {
      grid-template-columns: minmax(0, 42fr) minmax(0, 58fr);
      column-gap: 2.5rem;
      row-gap: 2rem;
      align-items: end;
    }

    .home-hero__title {
      grid-column: 2;
      grid-row: 1;
    }

    .home-hero__lead {
      grid-column: 1;
      grid-row: 1 / span 2;
      align-self: end;
      max-width: 30ch;
    }

    .home-hero__actions {
      grid-column: 2;
      grid-row: 2;
    }
  }
</style>

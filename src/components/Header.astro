---
import NavLinks from './NavLinks.astro';
import LocaleSwitch from './LocaleSwitch.astro';
import SiteName from './SiteName.astro';
import { tSite, siteConfig } from '~/config/site';
import type { Locale } from '~/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<header class="sticky top-0 z-40 border-b border-[var(--rule)] bg-[var(--bg)]">
  <div class="page-frame flex items-center justify-between gap-3 py-3">
    <SiteName locale={locale} />

    <div class="flex flex-none items-center gap-2 sm:gap-3">
      <nav aria-label={siteConfig.navSections.language[locale]}>
        <LocaleSwitch locale={locale} pathname={Astro.url.pathname} />
      </nav>

      <button
        type="button"
        data-menu-open
        aria-label={siteConfig.ui.openMenu[locale]}
        aria-controls="site-menu"
        aria-expanded="false"
        class="icon-btn"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          class="h-5 w-5"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M4 7h16"></path>
          <path d="M4 12h16"></path>
          <path d="M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<dialog
  id="site-menu"
  hidden
  aria-labelledby="site-menu-title"
  aria-modal="true"
  class="m-0 h-[100dvh] max-h-none w-screen max-w-none bg-[var(--bg)] text-[var(--ink)] backdrop:bg-[color-mix(in_oklch,var(--ink)_55%,transparent)] open:flex open:flex-col"
>
  <div class="page-frame flex items-center justify-between gap-4 border-b border-[var(--rule)] py-3">
    <h2 id="site-menu-title" class="text-xl">
      <SiteName locale={locale} />
    </h2>
    <button
      type="button"
      data-menu-close
      aria-label={siteConfig.ui.closeMenu[locale]}
      class="icon-btn"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        class="h-5 w-5"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M6 6l12 12"></path>
        <path d="M18 6l-12 12"></path>
      </svg>
    </button>
  </div>

  <div class="flex-1 overflow-y-auto">
    <div class="page-frame py-10">
      <p class="max-w-md text-xl text-[var(--ink-soft)]">{tSite('tagline', locale)}</p>

      <div class="mt-10 sm:mt-14">
        <NavLinks locale={locale} label={siteConfig.ui.siteMenu[locale]} variant="menu" />
      </div>
    </div>
  </div>
</dialog>

<script>
  import '~/scripts/site-menu.ts';
</script>

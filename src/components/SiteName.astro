---
import type { Locale } from '~/lib/i18n';
import { localizedPath } from '~/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<a href={localizedPath('/', locale)} class="inline-flex items-center gap-2.5 no-underline">
  <span
    class="inline-flex h-8 w-8 items-center justify-center rounded-[var(--radius-control)] bg-[var(--accent)] font-[family-name:var(--font-sans)] text-[0.9375rem] font-bold tracking-tight text-[var(--accent-ink)]"
    aria-hidden="true"
  >
    nl
  </span>
  <span class="font-[family-name:var(--font-sans)] text-base font-semibold tracking-tight text-[var(--ink)] min-[400px]:text-lg sm:text-xl">
    nllearn<span class="text-[var(--accent-text)]">.</span>ing
  </span>
</a>

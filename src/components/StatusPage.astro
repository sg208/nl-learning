---
interface Props {
  figure?: string;
  title: string;
  body: string;
}

const { figure, title, body } = Astro.props;
---

<section class:list={['status pt-12 sm:pt-20', figure && 'status--figure']}>
  {figure && (
    <p class="status__figure" aria-hidden="true">
      {figure}
    </p>
  )}
  <div class="status__text">
    <h1 class="status__title">{title}</h1>
    <p class="status__body">{body}</p>
    <div class="status__actions">
      <slot />
    </div>
  </div>
</section>

<style>
  .status {
    display: grid;
    gap: 1.5rem;
  }

  .status__figure {
    font-family: var(--font-display);
    font-size: clamp(5rem, 3rem + 10vw, 11rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--accent-text);
    font-variant-numeric: lining-nums;
  }

  .status__title {
    font-family: var(--font-display);
    font-size: clamp(2.125rem, 1.4rem + 2.6vw, 3.5rem);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.025em;
  }

  .status__body {
    max-width: 40ch;
    margin-top: 1rem;
    font-size: 1.1875rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .status__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  @media (min-width: 640px) {
    .status__actions {
      flex-direction: row;
    }
  }

  @media (min-width: 960px) {
    .status--figure {
      grid-template-columns: minmax(0, 42fr) minmax(0, 58fr);
      column-gap: 2.5rem;
      align-items: end;
    }
  }
</style>

---
import { legalPages } from '~/i18n/legal';
import type { Locale } from '~/lib/i18n';

interface Props {
  page: keyof typeof legalPages;
  locale?: Locale;
}

const { page, locale = 'en' } = Astro.props;
const content = legalPages[page][locale];
---

<article class="mx-auto max-w-3xl pt-6 sm:pt-10">
  <header class="mb-10">
    <p
      class="font-[family-name:var(--font-mono)] text-xs font-bold tracking-[0.25em] text-[var(--muted)] uppercase"
    >
      {content.eyebrow}
    </p>
    <h1
      class="mt-4 font-[family-name:var(--font-display)] text-4xl leading-tight font-bold tracking-tight text-balance sm:text-5xl"
    >
      {content.title}
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-[var(--muted)]">{content.intro}</p>
  </header>

  <div class="prose">
    {
      content.blocks.map((block) => (
        <>
          {block.heading && <h2>{block.heading}</h2>}
          {block.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </>
      ))
    }
  </div>
</article>

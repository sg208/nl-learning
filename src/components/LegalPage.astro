---
import { legalPages } from '~/i18n/legal';
import type { Locale } from '~/lib/i18n';

interface Props {
  page: keyof typeof legalPages;
  locale?: Locale;
}

const { page, locale = 'en' } = Astro.props;
const content = legalPages[page][locale];
---

<article class="legal pt-10 sm:pt-16">
  <header class="legal__head">
    <h1 class="font-[family-name:var(--font-display)] text-[clamp(2.125rem,1.4rem+2.6vw,3.5rem)] leading-[1.06] font-semibold tracking-[-0.025em]">
      {content.title}
    </h1>
    <p class="mt-3 font-[family-name:var(--font-sans)] text-base font-semibold text-[var(--muted)]">
      {content.eyebrow}
    </p>
    <p class="mt-6 max-w-[48ch] text-xl leading-relaxed text-[var(--ink-soft)]">{content.intro}</p>
  </header>

  <div class="prose legal__body">
    {content.blocks.map((block) => (
      <>
        {block.heading && <h2>{block.heading}</h2>}
        {block.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        {block.links && (
          <ul>
            {block.links.map((link) => (
              <li>
                <a href={link.href} class="underline">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        )}
      </>
    ))}
  </div>
</article>

<style>
  .legal__head {
    padding-bottom: 2.5rem;
  }

  @media (min-width: 960px) {
    .legal {
      display: grid;
      grid-template-columns: minmax(0, 42fr) minmax(0, 58fr);
      column-gap: 2.5rem;
      align-items: start;
    }

    .legal__body > :first-child {
      margin-top: 0;
    }
  }
</style>

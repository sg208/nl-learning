---
import { siteConfig, tSite } from '~/config/site';
import LocaleSwitch from './LocaleSwitch.astro';
import NavLinks from './NavLinks.astro';
import SiteName from './SiteName.astro';
import type { Locale } from '~/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
---

<footer
  class="relative z-10 mt-24 border-t border-[var(--rule)] pb-[calc(5rem+env(safe-area-inset-bottom,0px))] md:pb-0"
>
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
    <div class="grid gap-10 sm:grid-cols-[minmax(0,1fr)_2fr]">
      <section>
        <p>
          <SiteName locale={locale} />
        </p>
        <p class="mt-3 max-w-sm text-base text-[var(--muted)]">{tSite('tagline', locale)}</p>
      </section>

      <NavLinks locale={locale} label={siteConfig.ui.footerNav[locale]} variant="footer" />
    </div>

    <p class="mt-10 border-t border-[var(--rule)] pt-6 text-sm leading-relaxed text-[var(--muted)]">
      &copy; {year}
      {siteConfig.name}.
      {
        locale === 'en'
          ? 'Study material is for practice only — not an official DUO or government product.'
          : 'Studiemateriaal is alleen voor oefening — geen officieel DUO- of overheidsproduct.'
      }
    </p>
  </div>
</footer>

<div
  class="locale-float pointer-events-none fixed inset-x-0 bottom-0 z-50 flex justify-center px-4 pb-[max(1rem,env(safe-area-inset-bottom))] md:hidden"
>
  <nav
    aria-label={siteConfig.navSections.language[locale]}
    class="locale-float-pill pointer-events-auto"
  >
    <LocaleSwitch locale={locale} pathname={Astro.url.pathname} variant="float" />
  </nav>
</div>

---
import { siteConfig, tSite } from '~/config/site';
import NavLinks from './NavLinks.astro';
import SiteName from './SiteName.astro';
import type { Locale } from '~/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
const disclaimer =
  locale === 'en'
    ? 'Study material is for practice only — not an official DUO or government product.'
    : 'Studiemateriaal is alleen voor oefening — geen officieel DUO- of overheidsproduct.';
const copyright = `© ${year} ${siteConfig.name}. ${disclaimer}`;
---

<footer class="relative mt-24 bg-[var(--surface)] pb-[env(safe-area-inset-bottom,0px)] sm:mt-32">
  <div class="page-frame py-14 sm:py-20">
    <div class="grid gap-12 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
      <section>
        <p>
          <SiteName locale={locale} />
        </p>
        <p class="mt-6 max-w-[22ch] font-[family-name:var(--font-display)] text-[clamp(1.5rem,1.2rem+1.2vw,2.25rem)] leading-[1.15] font-medium tracking-[-0.015em] text-[var(--ink)]">
          {tSite('tagline', locale)}
        </p>
      </section>

      <NavLinks locale={locale} label={siteConfig.ui.footerNav[locale]} variant="footer" />
    </div>

    <p class="mt-14 text-lg">
      <a href={siteConfig.repoUrl}>
        {siteConfig.ui.sourceLink[locale]}
        <span class="sr-only">{` ${siteConfig.ui.sourceLinkHint[locale]}`}</span>
      </a>
    </p>
    <p class="mt-6 max-w-[70ch] text-base leading-relaxed text-[var(--muted)]">{copyright}</p>
  </div>
</footer>

---
import BaseLayout from '~/layouts/BaseLayout.astro';
import StatusPage from '~/components/StatusPage.astro';
---

<BaseLayout
  title="Offline"
  description="You are offline. Some cached pages may still be available."
  noindex
>
  <StatusPage
    title="You are offline"
    body="NL Learning can show cached pages when your connection returns. Try again, or reopen a page you visited recently."
  >
    <a href="/" class="btn btn-primary">
      Back to home
    </a>
  </StatusPage>
</BaseLayout>

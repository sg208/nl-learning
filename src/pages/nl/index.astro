---
import BaseLayout from '~/layouts/BaseLayout.astro';
import HomeHero from '~/components/HomeHero.astro';
import HomeStudy from '~/components/HomeStudy.astro';
import type { HomeFact } from '~/components/HomeFacts.astro';
import { siteConfig, tSite } from '~/config/site';
import { KNM_ROUTE_HASH } from '~/lib/knm-route';
import { organizationJsonLd } from '~/lib/seo';

const locale = 'nl' as const;

const copy = {
  audience: 'Voor nieuwkomers in Nederland.',
  titleLines: ['Leer de Nederlandse maatschappij —', 'helder, in je eigen tempo.'] as [
    string,
    string,
  ],
  lead: 'Gratis KNM-oefening met grote tekst, hoog contrast en offline ondersteuning. Gemaakt voor mensen die zich voorbereiden op inburgering en uitleg in het Engels of Nederlands willen.',
  ctaPrimary: 'Start KNM-oefening',
  ctaSecondary: 'Over dit project',
  factsLabel: 'Het KNM-examen in het kort',
  facts: [
    { value: '40', label: 'vragen per examen', tone: 'accent' },
    { value: '45', label: 'minuten', tone: 'strong' },
    { value: '26/40', label: 'goed om te slagen', tone: 'field' },
    { value: '8', label: "thema's", tone: 'plain' },
    { value: '9', label: 'versies van het oefenexamen', tone: 'tint' },
    { value: '2', label: 'talen: Engels en Nederlands', tone: 'strong' },
  ] satisfies HomeFact[],
  sectionIntro: 'Drie manieren om te beginnen. Begin met de notities en test jezelf daarna.',
  openLabel: 'Openen',
  cards: [
    {
      title: 'KNM oefenexamens',
      body: "40 vragen met timer over 8 thema's — dezelfde opzet als het echte examen.",
      href: `/knm${KNM_ROUTE_HASH.exam}`,
    },
    {
      title: 'Studienotities',
      body: 'Samenvattingen over gezondheid, werk, overheid, wonen, onderwijs, politiek, geschiedenis en cultuur.',
      href: `/knm${KNM_ROUTE_HASH.topics}`,
    },
    {
      title: 'Wie doet wat',
      body: 'Referentietabel voor de vraag: waar moet deze persoon heen?',
      href: `/knm${KNM_ROUTE_HASH.whowhat}`,
    },
  ],
  sectionTitle: 'Wat je hier kunt leren',
};

const siteUrl = Astro.site?.toString() ?? '';
const nlHomeUrl = `${siteUrl}/nl`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    organizationJsonLd(siteUrl),
    {
      '@type': 'WebSite',
      name: siteConfig.name,
      url: nlHomeUrl,
      description: tSite('description', locale),
      inLanguage: 'nl-NL',
      publisher: { '@id': `${siteUrl}/#org` },
    },
  ],
};
---

<BaseLayout locale={locale} jsonLd={jsonLd} fullBleed>
  <HomeHero
    locale={locale}
    audience={copy.audience}
    titleLines={copy.titleLines}
    lead={copy.lead}
    ctaPrimary={copy.ctaPrimary}
    ctaSecondary={copy.ctaSecondary}
    factsLabel={copy.factsLabel}
    facts={copy.facts}
  />

  <HomeStudy
    locale={locale}
    heading={copy.sectionTitle}
    intro={copy.sectionIntro}
    openLabel={copy.openLabel}
    cards={copy.cards}
  />
</BaseLayout>

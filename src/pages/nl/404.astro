---
import BaseLayout from '~/layouts/BaseLayout.astro';
import StatusPage from '~/components/StatusPage.astro';
import { localizedPath } from '~/lib/i18n';
---

<BaseLayout
  locale="nl"
  title="Pagina niet gevonden"
  description="De gevraagde pagina bestaat niet."
  noindex
>
  <StatusPage
    figure="404"
    title="Pagina niet gevonden"
    body="Deze route bestaat niet. Ga terug naar home of start KNM-oefening."
  >
    <a href="/nl" class="btn btn-primary">
      Home
    </a>
    <a href={localizedPath('/knm', 'nl')} class="btn btn-secondary">
      KNM oefenen
    </a>
  </StatusPage>
</BaseLayout>

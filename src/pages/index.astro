---
import BaseLayout from '~/layouts/BaseLayout.astro';
import HomeHero from '~/components/HomeHero.astro';
import HomeStudy from '~/components/HomeStudy.astro';
import type { HomeFact } from '~/components/HomeFacts.astro';
import { siteConfig, tSite } from '~/config/site';
import { KNM_ROUTE_HASH } from '~/lib/knm-route';
import { organizationJsonLd } from '~/lib/seo';

const locale = 'en' as const;

const copy = {
  audience: 'For newcomers in the Netherlands.',
  titleLines: ['Learn Dutch society —', 'clearly, at your pace.'] as [string, string],
  lead: 'Free KNM practice with big text and high contrast. Built for people preparing for civic integration who want explanations in English or Dutch.',
  ctaPrimary: 'Start KNM practice',
  ctaSecondary: 'About this project',
  factsLabel: 'The KNM exam at a glance',
  facts: [
    { value: '40', label: 'questions in one exam', tone: 'accent' },
    { value: '45', label: 'minutes', tone: 'strong' },
    { value: '26/40', label: 'correct to pass', tone: 'field' },
    { value: '8', label: 'topics', tone: 'plain' },
    { value: '9', label: 'mock exam versions', tone: 'tint' },
    { value: '2', label: 'languages: English and Dutch', tone: 'strong' },
  ] satisfies HomeFact[],
  sectionTitle: 'What you can study here',
  sectionIntro: 'Three ways in. Start with the notes, then test yourself.',
  openLabel: 'Open',
  cards: [
    {
      title: 'KNM mock exams',
      body: '40-question timed practice across 8 topics — the same shape as the real exam.',
      href: `/knm${KNM_ROUTE_HASH.exam}`,
    },
    {
      title: 'Study notes',
      body: 'Topic summaries for healthcare, work, government, housing, education, politics, history, and culture.',
      href: `/knm${KNM_ROUTE_HASH.topics}`,
    },
    {
      title: 'Who does what',
      body: 'A reference table for the most common question type: where should this person go?',
      href: `/knm${KNM_ROUTE_HASH.whowhat}`,
    },
  ],
};

const siteUrl = Astro.site?.toString() ?? '';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    organizationJsonLd(siteUrl),
    {
      '@type': 'WebSite',
      name: siteConfig.name,
      url: siteUrl,
      description: tSite('description', locale),
      inLanguage: 'en',
      publisher: { '@id': `${siteUrl}/#org` },
    },
  ],
};
---

<BaseLayout locale={locale} jsonLd={jsonLd} fullBleed>
  <HomeHero
    locale={locale}
    audience={copy.audience}
    titleLines={copy.titleLines}
    lead={copy.lead}
    ctaPrimary={copy.ctaPrimary}
    ctaSecondary={copy.ctaSecondary}
    factsLabel={copy.factsLabel}
    facts={copy.facts}
  />

  <HomeStudy
    locale={locale}
    heading={copy.sectionTitle}
    intro={copy.sectionIntro}
    openLabel={copy.openLabel}
    cards={copy.cards}
  />
</BaseLayout>

---
import BaseLayout from '~/layouts/BaseLayout.astro';
import StatusPage from '~/components/StatusPage.astro';
import { localizedPath } from '~/lib/i18n';
---

<BaseLayout title="Page not found" description="The page you requested could not be found." noindex>
  <StatusPage
    figure="404"
    title="Page not found"
    body="That route does not exist. Head back to the home page or start KNM practice."
  >
    <a href="/" class="btn btn-primary">
      Home
    </a>
    <a href={localizedPath('/knm', 'en')} class="btn btn-secondary">
      KNM practice
    </a>
  </StatusPage>
</BaseLayout>

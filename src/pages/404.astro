---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { localizedPath } from '~/lib/i18n';
---

<BaseLayout title="Page not found" description="The page you requested could not be found." noindex>
  <section class="mx-auto max-w-xl py-10 text-center">
    <p
      class="font-[family-name:var(--font-mono)] text-sm tracking-[0.2em] text-[var(--muted)] uppercase"
    >
      404
    </p>
    <h1 class="mt-4 font-[family-name:var(--font-display)] text-4xl font-bold">Page not found</h1>
    <p class="mt-4 text-lg text-[var(--muted)]">
      That route does not exist. Head back to the home page or start KNM practice.
    </p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/" class="btn btn-primary">Home</a>
      <a href={localizedPath('/knm', 'en')} class="btn btn-secondary">KNM practice</a>
    </div>
  </section>
</BaseLayout>
